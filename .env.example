# ============================================================================
# Variáveis de Ambiente — Businessmap (Kanbanize) CSV Importer
# ----------------------------------------------------------------------------
# Copia este ficheiro para `.env.local` e preenche com os teus valores reais.
# O `.env.local` está no .gitignore e NUNCA deve ser enviado para o repositório.
# ============================================================================

# Chave de API do Businessmap (Account Settings > API).
# Enviada no cabeçalho `apikey` de cada pedido. Mantém-na apenas no servidor.
BUSINESSMAP_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Subdomínio da tua conta Businessmap.
# Ex.: se acedes via https://acme.kanbanize.com  ->  BUSINESSMAP_DOMAIN=acme
BUSINESSMAP_DOMAIN=acme

# (Opcional) Atraso em milissegundos entre cada chamada à API para evitar
# erros HTTP 429 (Too Many Requests). Valor por defeito: 350ms.
BUSINESSMAP_RATE_LIMIT_MS=350

# (Opcional) Nº máximo de tentativas (retries) quando a API devolve 429/5xx.
BUSINESSMAP_MAX_RETRIES=3
